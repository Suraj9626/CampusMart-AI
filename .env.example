# ===================================================
# CAMPUSMART AI - ENVIRONMENT CONFIGURATION
# ===================================================

# Application
NEXT_PUBLIC_APP_NAME="CampusMart AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Approved College Email Domains (comma-separated)
# Users can only register with emails ending in these domains.
# Set to "*" to allow any academic or standard domain during testing.
APPROVED_COLLEGE_DOMAINS="stanford.edu,mit.edu,berkeley.edu,harvard.edu,columbia.edu,cmu.edu,nyu.edu,utexas.edu,ucla.edu,campus.edu,edu"

# Supabase (PostgreSQL, Auth, Storage, Realtime)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Gemini AI API Key (Server-side only)
# Used for the CampusMart AI Assistant chatbot
GEMINI_API_KEY="your-gemini-api-key-here"

# Security & Cron Secrets
# Used to authenticate scheduled jobs (e.g. closing expired auctions)
CRON_SECRET="campusmart-cron-secret-change-in-production"
